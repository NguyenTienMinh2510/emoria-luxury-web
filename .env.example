# Copy only the required entries into .env.local; do not replace existing keys.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# The existing VITE_SUPABASE_ANON_KEY is also supported; keep only the intended key.

# Public receiving-bank information. Never put a banking password/OTP here.
VITE_PAYMENT_BANK_NAME=
VITE_PAYMENT_ACCOUNT_NUMBER=
VITE_PAYMENT_ACCOUNT_NAME=
