# Copy only the required entries into .env.local; do not replace existing keys.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# The existing VITE_SUPABASE_ANON_KEY is also supported; keep only the intended key.
VITE_SUPABASE_ANON_KEY=

# Server only: required by /api/memory-media. NEVER prefix this with VITE_.
SUPABASE_SERVICE_ROLE_KEY=

# Legacy public receiving-bank fields. Current checkout uses admin store_settings.
# Never put a banking password/OTP here.
VITE_PAYMENT_BANK_NAME=
VITE_PAYMENT_ACCOUNT_NUMBER=
VITE_PAYMENT_ACCOUNT_NAME=

# Google Analytics 4 (Client tracking & Server reporting)
# Prefer setting the Measurement ID in admin store settings; VITE_ is a fallback.
VITE_GA4_MEASUREMENT_ID=
# Server only. Property ID is numeric; service account JSON contains a private key.
GA4_PROPERTY_ID=
GA4_SERVICE_ACCOUNT_JSON=
# Optional: restrict tracking and reports to the stable public website hostname.
VITE_GA4_HOSTNAME=
GA4_REPORT_HOSTNAME=
# Public demo site may measure consenting visitors while orders remain test orders.
VITE_GA4_TRACK_SANDBOX=false

# Server-only SePay webhook (Fallback chuyển khoản thủ công).
SEPAY_WEBHOOK_KEY=
SEPAY_ACCOUNT_NUMBER=
SEPAY_MODE=

# Server-only SePay Payment Gateway (Cổng thanh toán SePay trực tuyến)
# Tuyệt đối KHÔNG thêm tiền tố VITE_ để bảo vệ bí mật kinh doanh và an toàn giao dịch.
SEPAY_PG_MERCHANT_ID=
SEPAY_PG_SECRET_KEY=
SEPAY_PG_MODE=sandbox # sandbox | production
SEPAY_PG_IPN_URL=https://your-domain.vercel.app/api/sepay-ipn

# Google Gemini Video Understanding & Moderation (Server only - NO VITE_ prefix)
GEMINI_API_KEY=
GEMINI_VIDEO_MODEL=gemini-3.6-flash

# Qwen3-VL Modal Endpoint for Media Labeling & Moderation (Server only - 24/7 Cloud Microservice)
MODAL_TAGGER_URL=https://nguyentienminh2510--emoria-qwen-tagger-qwentagger-tag-video.modal.run
