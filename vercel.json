{
  "buildCommand": "npm run test:ci && npm run build",
  "regions": ["syd1"],
  "functions": {"api/v1.js": {"maxDuration": 180}, "api/share.js": {"includeFiles": "dist/index.html"}},
  "redirects": [
    { "source": "/", "has": [{"type":"query","key":"view","value":"memory-(house|match)"}], "destination": "/share", "permanent": false },
    { "source": "/", "has": [{"type":"query","key":"share"}], "destination": "/share", "permanent": false },
    { "source": "/", "has": [{"type":"query","key":"match"}], "destination": "/share", "permanent": false },
    { "source": "/", "has": [{"type":"query","key":"invite"}], "destination": "/share", "permanent": false },
    { "source": "/", "has": [{"type":"query","key":"article"}], "destination": "/share", "permanent": false },
    { "source": "/", "has": [{"type":"query","key":"tag"}], "destination": "/share", "permanent": false },
    { "source": "/", "has": [{"type":"query","key":"memory"}], "destination": "/share", "permanent": false },
    { "source": "/", "has": [{"type":"query","key":"chip"}], "destination": "/share", "permanent": false },
    { "source": "/", "has": [{"type":"query","key":"policy","value":"privacy"}], "destination": "/share", "permanent": false },
    { "source": "/", "has": [{"type":"query","key":"privacy","value":"true"}], "destination": "/share", "permanent": false }
  ],
  "rewrites": [
    { "source": "/share", "destination": "/api/share" },
    { "source": "/api/share", "destination": "/api/share" },
    { "source": "/api/v1/:resource*", "destination": "/api/v1?resource=:resource*" },
    { "source": "/api/sepay-webhook", "destination": "/api/sepay-webhook" },
    { "source": "/api/memory-media", "destination": "/api/memory-media" },
    { "source": "/api/analytics", "destination": "/api/analytics" },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
